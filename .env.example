ROS_DOMAIN_ID=20
ROVER_TELEMETRY_INTERVAL_SECONDS=1.0
ROVER_ROS_BRIDGE_ENABLED=true
ROVER_ROS_BRIDGE_REQUIRED=true
ROVER_ROS_SERVICE_TIMEOUT_SECONDS=10.0
ROVER_ROS_STATUS_TIMEOUT_SECONDS=2.0
ROVER_MAPPING_SESSION_DIR=/workspace/data/maps
ROVER_MAPPING_STARTUP_TIMEOUT_SECONDS=60
ROVER_RUNTIME_EVIDENCE_DIR=/workspace/data/evidence
ROVER_SLAM_PARAMS_FILE=
ROVER_BASELINE_DURATION_SECONDS=10
ROVER_ENABLE_WAKE_WORD=false
ROVER_ENABLE_ASR=false
ROVER_ENABLE_TTS=false
ROVER_CAMERA_STREAM_MODE=mjpeg
ROVER_TELEMETRY_HZ=2
ROVER_LIDAR_DOWNSAMPLE=1
MICROROS_SERIAL_DEVICE=/dev/myserial
MICROROS_SERIAL_BAUD=115200
ROVER_AI_ENABLED=false
ROVER_AI_BASE_URL=https://gmn.chuangzuoli.com/v1
ROVER_AI_MODEL=gpt-5.6
ROVER_AI_WIRE_API=chat_completions
ROVER_AI_API_KEY=
ROVER_AI_TIMEOUT_SECONDS=20
ROVER_AI_MAX_OUTPUT_TOKENS=512
ROVER_VOICE_GATEWAY_TOKEN=
ROVER_VOICE_TRANSCRIPT_MAX_CHARS=1000
ROVER_VOICE_CONFIRMATION_TTL_SECONDS=15
ROVER_VOICE_FOLLOWUP_SECONDS=8
ROVER_VOICE_STATUS_STALE_SECONDS=15
# Host voice service: keep these paths outside Git and provide stable ALSA aliases.
ROVER_VOICE_ENABLED=false
ROVER_VOICE_MODEL_DIR=/opt/jarvis-rover/models
ROVER_WAKEWORD_MODEL=/opt/jarvis-rover/models/wakeword/nihao_javis.onnx
ROVER_ASR_MODEL_DIR=/opt/jarvis-rover/models/asr
ROVER_TTS_MODEL=/opt/jarvis-rover/models/tts/zh_CN-model.onnx
ROVER_TTS_CONFIG=/opt/jarvis-rover/models/tts/zh_CN-model.onnx.json
ROVER_VOICE_CAPTURE_DEVICE=jarvis_mic
ROVER_VOICE_PLAYBACK_DEVICE=jarvis_speaker
ROVER_VOICE_GATEWAY_URL=http://127.0.0.1:8000/api/v1/voice
ROVER_VOICE_SAMPLE_RATE=16000
ROVER_VOICE_CHANNELS=1
ROVER_VOICE_RECORD_MAX_SECONDS=15
ROVER_VOICE_FOLLOWUP_SECONDS=8
ROVER_VOICE_VAD_SILENCE_MS=700
ROVER_WAKEWORD_THRESHOLD=0.5
ROVER_WAKEWORD_COOLDOWN_SECONDS=2
