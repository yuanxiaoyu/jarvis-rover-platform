ROS_DOMAIN_ID=20
ROVER_API_PORT=8001
ROVER_ROS_BRIDGE_ENABLED=true
ROVER_MAPPING_SESSION_DIR=/workspace/data/maps
ROVER_CAMERA_DEVICE=/dev/video0
ROVER_CAMERA_WIDTH=1280
ROVER_CAMERA_HEIGHT=720
ROVER_CAMERA_FPS=60
ROVER_GIMBAL_PAN_TOPIC=/servo_s1
ROVER_GIMBAL_TILT_TOPIC=/servo_s2
ROVER_TELEMETRY_INTERVAL_SECONDS=1.0
MICROROS_SERIAL_DEVICE=/dev/myserial
MICROROS_SERIAL_BAUD=115200
RPLIDAR_DEVICE=/dev/rplidar

# Voice and assistant are disabled by default. Inject secrets outside Git.
ROVER_VOICE_ENABLED=false
ROVER_VOICE_CAPTURE_DEVICE=
ROVER_VOICE_PLAYBACK_DEVICE=
ROVER_VOICE_GATEWAY_URL=http://127.0.0.1:8001/api/v1/voice
ROVER_VOICE_GATEWAY_TOKEN=
ROVER_WAKEWORD_PHRASE=贾维斯
ROVER_VOICE_SAMPLE_RATE=16000
ROVER_VOICE_CHANNELS=1
ROVER_VOICE_RECORD_MAX_SECONDS=15
ROVER_VOICE_FOLLOWUP_SECONDS=8
ROVER_VOICE_WAKE_ACK_TEXT=我在，请说。
ROVER_WAKEWORD_MODEL=
ROVER_WAKEWORD_THRESHOLD=0.5
ROVER_WAKEWORD_SCORE=2.0
ROVER_WAKEWORD_KEYWORDS_FILE=
ROVER_WAKEWORD_COOLDOWN_SECONDS=2
ROVER_ASR_MODEL_DIR=
ROVER_VOICE_MIN_CONFIDENCE=0.35
ROVER_TTS_MODEL_DIR=
ROVER_TTS_ENGINE=pocket_tts
ROVER_TTS_CONFIG=
ROVER_TTS_CHECKPOINT=
ROVER_TTS_VOICE_STATE=
ROVER_TTS_DEVICE=cpu
ROVER_TTS_PLAYBACK_SAMPLE_RATE=24000
ROVER_TTS_SPEAKER_ID=21
ROVER_TTS_RULE_FSTS=

ROVER_AI_ENABLED=false
ROVER_AI_BASE_URL=https://totokens.cc/v1
ROVER_AI_MODEL=gpt-5.6-sol
ROVER_AI_WIRE_API=chat_completions
ROVER_AI_API_KEY=
ROVER_AI_TIMEOUT_SECONDS=20
ROVER_AI_MAX_OUTPUT_TOKENS=512
ROVER_VOICE_CONFIRMATION_TTL_SECONDS=15
ROVER_VOICE_STATUS_STALE_SECONDS=15
