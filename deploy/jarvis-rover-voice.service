[Unit]
Description=Jarvis Rover local voice assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
SupplementaryGroups=audio
EnvironmentFile=-/etc/jarvis-rover/voice.env
WorkingDirectory=@REPO_DIR@/services/voice
ExecStart=@VOICE_PYTHON@ -m rover_voice.cli run
Restart=on-failure
RestartSec=10

# The voice process is independent of the ROS runtime and cannot control it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=@REPO_DIR@
ReadWritePaths=/run /var/lib/jarvis-rover
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
