FROM node:24-bookworm-slim AS web-build

WORKDIR /workspace/apps/web
COPY apps/web/package.json ./
COPY apps/web/package-lock.json ./
COPY apps/web/tsconfig.json ./
COPY apps/web/tsconfig.app.json ./
COPY apps/web/tsconfig.node.json ./
COPY apps/web/vite.config.ts ./
COPY apps/web/index.html ./
COPY apps/web/src ./src
RUN npm ci && npm run build

FROM ros:humble-ros-base-jammy AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-colcon-common-extensions \
    ros-humble-rosbridge-server \
    ros-humble-nav2-bringup \
    ros-humble-slam-toolbox \
    ros-humble-robot-localization \
    ros-humble-imu-tools \
    python3-yaml \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Keep the original ROS dependency layer cacheable; camera tooling is an
# additional runtime dependency and the camera is mounted as a single device.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    v4l-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY services/api /workspace/services/api
# The runtime image needs an installed application, not an editable development
# checkout. Ubuntu's packaged build frontend may not expose PEP 660, so an
# editable install prevents the API container from ever starting.
RUN python3 -m pip install --no-cache-dir /workspace/services/api

COPY ros2_ws /workspace/ros2_ws
RUN bash -lc "source /opt/ros/humble/setup.bash && cd /workspace/ros2_ws && colcon build --symlink-install"

COPY --from=web-build /workspace/apps/web/dist /workspace/services/api/app/static
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8001

ENTRYPOINT ["/entrypoint.sh"]
CMD ["api"]
