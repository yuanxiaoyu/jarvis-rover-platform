<?xml version="1.0"?>
<package format="3">
  <name>rover_bringup</name>
  <version>0.1.0</version>
  <description>Bringup package for rover stack orchestration.</description>
  <maintainer email="dev@rover.local">Rover Dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>
  <depend>imu_complementary_filter</depend>
  <depend>robot_localization</depend>
  <depend>slam_toolbox</depend>
  <depend>tf2_ros</depend>
  <depend>rover_interfaces</depend>

  <exec_depend>rover_safety</exec_depend>
  <exec_depend>rover_mapping</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

